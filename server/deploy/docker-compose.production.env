# ==========
# RDFM setup
# ==========

# The name of this file
SETUP_FILE=docker-compose.production.env

# Server settings
# ---------------

# Public address base for the services
PUBLIC_ADDRESS=rdfm.antmicro.com
PUBLIC_URL=https://${PUBLIC_ADDRESS}

# Application settings
# --------------------

RDFM_API_PORT=5000
RDFM_DB_CONNSTRING=sqlite:////database/db.db
RDFM_HOSTNAME=rdfm-server
RDFM_SERVER_INTERNAL_URL=http://${RDFM_HOSTNAME}:${RDFM_API_PORT}

# Bucket settings
# ---------------

RUSTFS_HOSTNAME=rustfs
RUSTFS_PORT=9000
RUSTFS_ADDRESS=${RUSTFS_HOSTNAME}:${RUSTFS_PORT}
RUSTFS_INTERNAL_URL=http://${RUSTFS_HOSTNAME}:${RUSTFS_PORT}

RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_PORT=9001
RUSTFS_CONSOLE_ADDRESS=${RUSTFS_HOSTNAME}:${RUSTFS_CONSOLE_PORT}

RUSTFS_TLS_PATH=/certs/

RUSTFS_OBS_LOGGER_LEVEL=error
RUSTFS_OBS_LOG_DIRECTORY=/var/log/rustfs/
RUSTFS_OBS_LOG_ROTATION_SIZE_MB=10
RUSTFS_OBS_LOG_ROTATION_TIME=hourly
RUSTFS_OBS_LOG_KEEP_FILES=5


RDFM_STORAGE_DRIVER=s3
RDFM_S3_URL=http://${RUSTFS_ADDRESS}
RDFM_S3_BUCKET=rdfm-packages

# NGINX settings
# -------------

NGINX_PORT=443
NGINX_CERTIFICATE=/etc/nginx/certs/SERVER.crt
NGINX_CERTIFICATE_KEY=/etc/nginx/certs/SERVER.key

# Database settings
# -----------------

# Hostname for the postgres container
DB_HOSTNAME=postgres
# Name of the database
DB_NAME=cloud-rdfm

# Keycloak settings
# -----------------

KC_FEATURES="hostname:v2"
KC_HTTP_RELATIVE_PATH=/kc
KC_PROXY_HEADERS=xforwarded
# > Set --proxy-trusted-addresses to the IP addresses of your proxy to ensure forwarded headers are accepted
# > only from these IP addresses. Note that this is only weak protection because IP addresses can be spoofed.
KC_PROXY_TRUSTED_ADDRESSES=172.16.0.0/16
KC_HTTPS_CERTIFICATE_FILE=/certs/KEYCLOAK.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/certs/KEYCLOAK.key
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KEYCLOAK_PORT=8443
KEYCLOAK_INTERNAL_URL=https://keycloak:${KEYCLOAK_PORT}${KC_HTTP_RELATIVE_PATH}
KEYCLOAK_EXTERNAL_URL=https://${PUBLIC_ADDRESS}${KC_HTTP_RELATIVE_PATH}
KC_HOSTNAME=${KEYCLOAK_EXTERNAL_URL}
KEYCLOAK_REALM=rdfm
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${DB_HOSTNAME}/${DB_NAME}

RDFM_OAUTH_URL=${KEYCLOAK_INTERNAL_URL}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/token/introspect

# Variables requiring modification
# ================================

# WARNING: If any of the variables within this section remains unmodified, it may pose a security threat
# to the created services.

# RDFM settings
# -------------

RDFM_OAUTH_CLIENT_ID=rdfm-server-introspection
RDFM_OAUTH_CLIENT_SEC=nsGrKQL8iwPzTz9IrP3sNI22J1vKVIh1

RDFM_MGMT_OAUTH_CLIENT_ID="rdfm-mgmt"
RDFM_MGMT_OAUTH_CLIENT_SEC=9AlxiuSoMaIJiegBN9KQjchd8FRZ4qBW

RDFM_S3_ACCESS_KEY_ID=admin
RDFM_S3_ACCESS_SECRET_KEY=admin123

RDFM_JWT_SECRET=d06b0ae464ba115c72b37e02d713a34f58396995b64075181aed795f653fd39b

# Keycloak credentials
# --------------------

# Starting administrator for Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME="admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="admin"

# Name of the database user
DB_USER=db_user
# Password for DB_USER
DB_PASSWORD=db_password

# Databse credentials for Keycloak
KC_DB_USERNAME=${DB_USER}
KC_DB_PASSWORD=${DB_PASSWORD}
